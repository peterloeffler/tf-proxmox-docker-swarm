      "versionNonce": 613628804,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "komodo.compose.yaml   uploaded by terraform\ncompose.env           uploaded by terraform\nmongo/data            -> /data/db\nmongo/config          -> /data/configdb\nkeys/                 -> /config/keys\n                         shared by core and\n                         every periphery task\nbackups/              -> /backups\nperiphery/swarm01-001 -> same path inside\nperiphery/swarm01-002    the container,\nperiphery/swarm01-003    one per node",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "komodo.compose.yaml   uploaded by terraform\ncompose.env           uploaded by terraform\nmongo/data            -> /data/db\nmongo/config          -> /data/configdb\nkeys/                 -> /config/keys\n                         shared by core and\n                         every periphery task\nbackups/              -> /backups\nperiphery/swarm01-001 -> same path inside\nperiphery/swarm01-002    the container,\nperiphery/swarm01-003    one per node",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "el41",
      "type": "text",
      "x": 986,
      "y": 740,
      "width": 384.53999999999996,
      "height": 97.5,
      "angle": 0,
      "strokeColor": "#d9480f",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1137651679,
      "version": 1,
      "versionNonce": 599707678,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Every service can be rescheduled onto any node,\nbecause none of its state lives on the node itself.\n\nNot removed by tofu destroy - clean up with\nceph auth del client.<swarm_name> and rm -rf\nthe directory on a Proxmox host.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every service can be rescheduled onto any node,\nbecause none of its state lives on the node itself.\n\nNot removed by tofu destroy - clean up with\nceph auth del client.<swarm_name> and rm -rf\nthe directory on a Proxmox host.",
      "lineHeight": 1.25,
      "autoResize": true
    },
